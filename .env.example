# ==========================================
# Server Configuration
# ==========================================
# The port on which the Express server runs
PORT=5000

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# ==========================================
# Database Configuration
# ==========================================
# MongoDB connection URI (Local MongoDB or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_db

# ==========================================
# CORS / Client Configuration
# ==========================================
# Allowed Frontend client origin for CORS and cookie credentials
CLIENT_URL=http://localhost:3000

# ==========================================
# JWT Authentication & Cookie Tokens
# ==========================================
# Secret key used to sign access tokens (use a strong, random key in production)
ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Expiration duration for access tokens (e.g. 15m, 1h)
ACCESS_TOKEN_EXPIRES_IN=15m

# Secret key used to sign refresh tokens (must be different from access token secret)
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Expiration duration for refresh tokens (e.g. 7d, 30d)
REFRESH_TOKEN_EXPIRES_IN=7d

# ==========================================
# Security / Bcrypt Configuration
# ==========================================
# Number of salt rounds for bcrypt password hashing
SALT_ROUNDS=10
